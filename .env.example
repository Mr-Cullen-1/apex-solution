# Copy to .env.local and fill in real values. Never commit .env.local or any
# file containing real secrets.

# Public production site URL, used for canonical URLs, sitemap, and Open
# Graph/JSON-LD absolute links.
NEXT_PUBLIC_SITE_URL=

# Reviews (Phase 1) — server-only Supabase credentials. Required for
# POST/GET /api/reviews to work; without them both return a 503
# "not_configured" response rather than crashing the build or faking
# success. See docs/REVIEWS_ARCHITECTURE.md.
#
# SUPABASE_SECRET_KEY is a privileged secret (current Supabase naming). It
# must never be prefixed with NEXT_PUBLIC_ and must never be sent to the
# browser. SUPABASE_SERVICE_ROLE_KEY (older naming) is still read as a
# fallback if SUPABASE_SECRET_KEY is unset — set only one.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Admin (Phase 1) — server-only Supabase Auth "publishable" key, used only
# by the admin sign-in/session client (src/lib/supabase/auth-server.ts) to
# authenticate admin users via real Supabase Auth cookies. This is a
# separate responsibility from SUPABASE_SECRET_KEY above: the auth client
# never touches application tables, and the privileged repository client
# never handles a login session — see docs/ADMIN_ARCHITECTURE.md. Not
# prefixed with NEXT_PUBLIC_: the whole admin login/session flow is
# server-action/cookie based, so this key never needs to reach the browser.
# It is not a privileged secret the way SUPABASE_SECRET_KEY is, but it must
# still never be committed with a real value.
SUPABASE_PUBLISHABLE_KEY=

# Reviews (Phase 2) — server-only random secret used to derive one-way
# review submission rate-limit keys (SHA-256 of this salt + the client IP;
# the raw IP is never stored). Generate a strong random value yourself —
# never commit a real value here. If unset, submissions are not rate
# limited (a loud server-side warning is logged on every submission until
# this is set) — do not substitute a fixed/predictable value instead.
REVIEW_RATE_LIMIT_SALT=

# Book Now (Phase 1) — server-only Telegram bot credentials used to deliver
# an operational notification for each stored service_requests lead. Never
# prefix these with NEXT_PUBLIC_. Without them, leads still persist to
# Supabase normally; only the Telegram notification is skipped (logged,
# telegram_status is marked "failed"). See docs/BOOK_NOW_ARCHITECTURE.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: send into a specific forum topic/thread within TELEGRAM_CHAT_ID
# instead of the group's general chat. Not required for Phase 1.
# TELEGRAM_THREAD_ID=

# Book Now (Phase 2) — server-only Resend credentials used to send a
# transactional confirmation email, only when the customer supplied one.
# Never prefix these with NEXT_PUBLIC_. Without them, leads still persist
# and Telegram still fires normally; only the confirmation email is skipped
# (logged, email_status is marked "failed"). RESEND_FROM_EMAIL must be an
# address on a Resend-verified sending domain (e.g.
# "Apex Home Services <no-reply@apexhomesupport.com>") — never
# onboarding@resend.dev in production. See docs/BOOK_NOW_ARCHITECTURE.md.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: Reply-To address for the confirmation email. Omitted entirely
# (not a fabricated fallback) when unset.
RESEND_REPLY_TO=

# Chat (Phase 2) — server-only Gemini API key used by POST /api/chat
# (src/features/chat/gemini.ts) to answer visitor questions in the Apex
# Assistant chat panel. Never prefix this with NEXT_PUBLIC_ — the key must
# never reach the browser; all Gemini calls happen server-side only.
# Required only for live AI chat: without it, POST /api/chat returns a
# controlled "not_configured" response and the chat UI shows a friendly
# connection-error fallback instead of crashing. See
# docs/CHAT_ARCHITECTURE.md.
GEMINI_API_KEY=

# Chat (Phase 3) — server-only random secret used to derive one-way
# POST /api/chat rate-limit keys (SHA-256 of this salt + IP + User-Agent;
# neither raw value is stored). Generate a strong random value yourself —
# never commit a real value here. Deliberately a separate secret from
# REVIEW_RATE_LIMIT_SALT above (distinct salt per hashing purpose). If
# unset, chat requests are not rate limited (a loud server-side warning is
# logged) — do not substitute a fixed/predictable value instead. Requires
# supabase/migrations/20260917100000_create_chat_rate_limit.sql to be
# applied; until then (or outside NODE_ENV=production) rate limiting is a
# no-op by design — see docs/CHAT_ARCHITECTURE.md.
CHAT_RATE_LIMIT_SALT=
